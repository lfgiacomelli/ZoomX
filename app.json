{
  "expo": {
    "name": "ZoomX",
    "slug": "zoomx",
    "scheme": "zoomx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon_zx.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.4fordevs.zoomx"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon_zx.png",
        "backgroundColor": "#000"
      },
      "useNextNotificationsApi": true,
      "package": "com.fourdevs.zoomx",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAPcGiGatTYgEyp9Q6-fGCDKMVKm8w9kVI"
        }
      }
    },
    "web": {
      "favicon": "./src/assets/images/icon_zx.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/logo.png",
          "color": "#000000",
          "sounds": [
            "./src/assets/sound/notificacao.wav"
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9046af95-c23e-4a4b-9205-25e2b7e5d3cf"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9046af95-c23e-4a4b-9205-25e2b7e5d3cf"
    }
  }
}
